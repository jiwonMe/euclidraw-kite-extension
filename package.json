{
  "name": "penrose-studio-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check:dist": "pnpm build && git diff --exit-code -- dist/plugin.js alid.extension.json src/generated/penrose-worker.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:dist"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@penrose/core": "3.3.1",
    "mathjax-full": "3.2.2"
  }
}
